---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { CATEGORIES } from "@/data/categories";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`Категорії | ${config.site.title}`}
  description="Редакційні категорії Leader Blog: лідерство, психологія, переговори, маніпуляції, правова психологія та соціальні системи."
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Категорії"
    pageDesc="Постійна таксономія для аналітичних матеріалів Leader Blog."
  >
    <ul class="grid gap-4 sm:grid-cols-2">
      {CATEGORIES.map(category => (
        <li class="border-border bg-muted/30 p-4">
          <a
            href={getRelativeLocaleUrl(locale, `categories/${category.slug}`)}
            class="group block"
          >
            <h2 class="text-xl font-semibold group-hover:text-accent">
              {category.title}
            </h2>
            <p class="mt-2 text-muted-foreground">{category.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </Main>

  <Footer />
</Layout>
