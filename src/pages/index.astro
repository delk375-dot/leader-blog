---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import KnowledgeGraphNav from "@/components/KnowledgeGraphNav.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { CATEGORIES } from "@/data/categories";
import { SERVICE_CTA, TOPIC_HUBS } from "@/data/knowledge";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const featuredTopics = TOPIC_HUBS.filter(topic => topic.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout
  title="Тіньова карта — закулісна аналітика влади, переговорів і соціальних систем"
  description="Інтелектуальна платформа про переговори, владу, соціальні механіки, статус, конфлікти та прихований вплив."
>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-16 pb-14 sm:pt-24 sm:pb-20">
      <div class="max-w-3xl">
        <p class="text-muted-foreground text-sm leading-6 uppercase tracking-[0.22em]">
          Закулісна аналітика для керівників
        </p>

        <h1 class="mt-7 text-5xl leading-[1.05] font-semibold tracking-normal sm:text-7xl">
          Тіньова карта
        </h1>

        <p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9">
          Платформа про приховані механіки влади, переговорів, статусу, конфліктів і
          соціального впливу. Тут досліджуються не офіційні декларації, а те, як
          системи реально поводяться під тиском страху, інтересу та комунікації.
        </p>
      </div>

      <div class="mt-10 flex flex-wrap gap-3 sm:mt-12">
        <LinkButton
          href={getRelativeLocaleUrl(locale, "topics")}
          class="bg-accent text-accent-foreground px-5 py-3 hover:opacity-90"
        >
          Відкрити дослідження
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
        <LinkButton
          href={getRelativeLocaleUrl(locale, "categories")}
          class="border-border border px-5 py-3 hover:text-accent"
        >
          Архів тем
        </LinkButton>
      </div>
    </section>

    <section id="knowledge-map" class="border-border border-b py-14 sm:py-20">
      <div class="mb-8 max-w-2xl">
        <h2 class="text-3xl font-semibold tracking-normal">Архів досліджень</h2>
        <p class="mt-4 text-base leading-8 text-muted-foreground">
          Структурована база матеріалів про переговори, соціальні системи, владу,
          комунікацію, психологію конфліктів і приховані механіки впливу.
        </p>
      </div>
      <KnowledgeGraphNav />
    </section>

    <section id="featured-topics" class="border-border border-b py-14 sm:py-20">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-semibold tracking-normal">Ключові теми</h2>
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2">
        {featuredTopics.map(topic => (
          <li class="border-border bg-muted/20 border p-5 sm:p-6">
            <a
              href={getRelativeLocaleUrl(locale, `topics/${topic.slug}`)}
              class="group block"
            >
              <h3 class="text-lg font-semibold group-hover:text-accent">
                {topic.ukrainianTitle}
              </h3>
              <p class="mt-3 text-sm leading-7 text-muted-foreground">
                {topic.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="categories" class="border-border border-b py-14 sm:py-20">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-semibold tracking-normal">Тематичні кластери</h2>
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {CATEGORIES.map(category => (
          <li class="border-border bg-muted/20 border p-5">
            <a
              href={getRelativeLocaleUrl(locale, `categories/${category.slug}`)}
              class="group block"
            >
              <h3 class="text-lg font-semibold group-hover:text-accent">
                {category.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-muted-foreground">
                {category.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="services" class="border-border border-b py-14 sm:py-20">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-semibold tracking-normal">Практичні формати</h2>
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2">
        {SERVICE_CTA.map(service => (
          <li class="border-border bg-muted/20 border p-5 sm:p-6">
            <h3 class="text-lg font-semibold">{service.title}</h3>
            <p class="mt-3 text-sm leading-7 text-muted-foreground">
              {service.description}
            </p>
          </li>
        ))}
      </ul>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-16 pb-8 sm:pt-20 sm:pb-10",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-normal">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 ? (
        <section id="recent-posts" class="pt-16 pb-8 sm:pt-20 sm:pb-10">
          <h2 class="text-2xl font-semibold tracking-normal">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      ) : (
        <section id="recent-posts" class="border-border border-b py-14 sm:py-20">
          <h2 class="text-2xl font-semibold tracking-normal">
            {t.home.recentPosts}
          </h2>
          <p class="mt-4 text-muted-foreground">
            Архітектура готова до перших матеріалів.
          </p>
        </section>
      )
    }

    <div class="my-12 text-center sm:my-16">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>