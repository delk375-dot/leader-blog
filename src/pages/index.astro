---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import KnowledgeGraphNav from "@/components/KnowledgeGraphNav.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { CATEGORIES } from "@/data/categories";
import { SERVICE_CTA, TOPIC_HUBS } from "@/data/knowledge";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const featuredTopics = TOPIC_HUBS.filter(topic => topic.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-10 pb-8 sm:pt-14">
      <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
        <span class="border-border border-b pb-1 uppercase tracking-[0.18em]">
          Executive knowledge base
        </span>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="inline-flex items-center gap-2 hover:text-accent"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss width={18} height={18} class="stroke-accent stroke-3" />
          <span>RSS</span>
        </a>
      </div>

      <h1 class="my-6 max-w-4xl text-4xl leading-tight font-semibold sm:text-6xl">
        Leader Blog
      </h1>

      <p class="max-w-4xl text-lg leading-8 text-muted-foreground sm:text-xl">
        Темна інтелектуальна медіаплатформа для керівників: психологія влади,
        переговори, правова психологія, соціальні системи, статус, конфлікти і
        точна комунікація.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <LinkButton
          href={getRelativeLocaleUrl(locale, "topics")}
          class="bg-accent text-accent-foreground px-4 py-2 hover:opacity-90"
        >
          Дослідити knowledge hubs
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
        <LinkButton
          href={getRelativeLocaleUrl(locale, "categories")}
          class="border-border border px-4 py-2 hover:text-accent"
        >
          Карта категорій
        </LinkButton>
      </div>

      {
        socials.length > 0 && (
          <div class="mt-8 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap text-muted-foreground sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="knowledge-map" class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold tracking-wide">Knowledge graph</h2>
      <p class="mt-2 mb-5 text-muted-foreground">
        Внутрішня структура для SEO, AI search, semantic indexing і long-tail запитів.
      </p>
      <KnowledgeGraphNav />
    </section>

    <section id="featured-topics" class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold tracking-wide">Featured topics</h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2">
        {featuredTopics.map(topic => (
          <li class="border-border bg-muted/30 border p-4">
            <a
              href={getRelativeLocaleUrl(locale, `topics/${topic.slug}`)}
              class="group block"
            >
              <p class="text-muted-foreground text-sm uppercase tracking-[0.14em]">
                {topic.title}
              </p>
              <h3 class="mt-2 text-lg font-semibold group-hover:text-accent">
                {topic.ukrainianTitle}
              </h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">
                {topic.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="categories" class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold tracking-wide">Content clusters</h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {CATEGORIES.map(category => (
          <li class="border-border bg-muted/30 p-4">
            <a
              href={getRelativeLocaleUrl(locale, `categories/${category.slug}`)}
              class="group block"
            >
              <h3 class="text-lg font-semibold group-hover:text-accent">
                {category.title}
              </h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">
                {category.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="services" class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold tracking-wide">Практичні формати</h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2">
        {SERVICE_CTA.map(service => (
          <li class="border-border bg-muted/30 border p-4">
            <h3 class="text-lg font-semibold">{service.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              {service.description}
            </p>
          </li>
        ))}
      </ul>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 ? (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      ) : (
        <section id="recent-posts" class="border-border border-b py-10">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <p class="mt-3 text-muted-foreground">
            Архітектура готова до перших матеріалів.
          </p>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
