---
import { getRelativeLocaleUrl } from "astro:i18n";
import { CATEGORIES } from "@/data/categories";
import { TOPIC_HUBS } from "@/data/knowledge";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<nav class="border-border bg-muted/20 border p-4" aria-label="Карта знань">
  <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
    <section>
      <h2 class="text-lg font-semibold">Категорії знань</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {CATEGORIES.map(category => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `categories/${category.slug}`)}
              class="border-border hover:border-accent hover:text-accent inline-block border px-3 py-1 text-sm"
            >
              {category.title}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-lg font-semibold">Тематичні центри</h2>
      <ul class="mt-3 space-y-2">
        {TOPIC_HUBS.map(topic => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `topics/${topic.slug}`)}
              class="hover:text-accent underline decoration-dashed underline-offset-4"
            >
              {topic.ukrainianTitle}
            </a>
            <p class="text-muted-foreground text-sm">{topic.description}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</nav>
